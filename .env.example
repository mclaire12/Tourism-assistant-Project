# Copy this file to .env for local development.
# On Streamlit Community Cloud, enter the same names in Settings → Secrets.
# Do not put real passwords in this file.

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Leave MODEL_PROVIDER empty to quote retrieved records with no language model.
# Supported values: huggingface, openai_compatible, local
MODEL_PROVIDER=
MODEL_API_URL=https://router.huggingface.co/v1
MODEL_API_KEY=
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# auto uses BAAI/bge-m3 when sentence-transformers is installed.
# hashed is the free-hosting default and keeps a 1024-dimension ChromaDB index.
EMBEDDING_PROVIDER=hashed
EMBEDDING_MODEL=BAAI/bge-m3

REQUEST_TIMEOUT=45
